# Paste into Streamlit Community Cloud: your app > Settings > Secrets.

[rr]
github_repo = "YOUR-GITHUB-USERNAME/rrdash"   # owner/name of this repository
data_branch = "data"
# Fine-grained personal access token: this repository only, "Contents: Read-only".
github_token = "github_pat_..."

# Optional:
# demo = true                     # show invented sample data (e.g. before the first pull)
# access_code = "choose-a-code"   # require a shared code; leave out for open access by link
